<?xml version="1.0" encoding="utf-8"?>
<!-- Windows App Service (IIS): strip /enterprise-project-portfolio-command-center/react, serve real
     files, fall back to index.html for SPA routes (factory/standards/publishing-base-path.md). -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Prefixed static files" stopProcessing="true">
          <match url="^enterprise-project-portfolio-command-center/react/(.+)$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}/{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}" />
        </rule>
        <rule name="Prefixed SPA routes" stopProcessing="true">
          <match url="^enterprise-project-portfolio-command-center/react(/.*)?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <rule name="Root redirect to mount" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/enterprise-project-portfolio-command-center/react/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>