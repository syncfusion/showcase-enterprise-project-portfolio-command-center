{
  "name": "enterprise-project-portfolio-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-theme.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-theme.mjs",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "start": "node server.mjs",
    "test:browser": "node browser-check.mjs --config browser-check.config.json",
    "evidence": "node run-evidence.mjs --plan evidence-plan.json"
  },
  "dependencies": {
    "@syncfusion/ej2-react-buttons": "34.2.8",
    "@syncfusion/ej2-react-charts": "34.2.8",
    "@syncfusion/ej2-react-diagrams": "34.2.8",
    "@syncfusion/ej2-react-dropdowns": "34.2.8",
    "@syncfusion/ej2-react-gantt": "34.2.8",
    "@syncfusion/ej2-react-grids": "34.2.8",
    "@syncfusion/ej2-react-kanban": "34.2.8",
    "@syncfusion/ej2-react-navigations": "34.2.8",
    "@syncfusion/ej2-react-notifications": "34.2.8",
    "@syncfusion/ej2-react-popups": "34.2.8",
    "@syncfusion/ej2-tailwind3-theme": "34.2.8",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
